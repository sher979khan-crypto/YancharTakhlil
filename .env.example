# Market data source (default auto):
#   auto      CoinGecko when COINGECKO_API_KEY is set, otherwise fixture (sample data + demo banner)
#   fixture   always sample data
#   coingecko always CoinGecko; without a key the app fails with a CONFIG error (never demo data)
MARKET_DATA_PROVIDER=
# CoinGecko API key (Demo during development). Server-only: sent only in the request header.
COINGECKO_API_KEY=
# CoinGecko plan for the key above: demo (default) or pro, case-insensitive
COINGECKO_API_PLAN=
# OpenRouter API key for the Assistant agent "Kotib"
OPENROUTER_API_KEY_ASSISTANT=
# OpenRouter API key for the Analyst agent "Tahlilchi"
OPENROUTER_API_KEY_ANALYST=
# Optional override of the Assistant model ID (default lives in src/config/ai.ts)
OPENROUTER_MODEL_ASSISTANT=
# Optional override of the Analyst model ID (default lives in src/config/ai.ts)
OPENROUTER_MODEL_ANALYST=
# Public base URL for canonical links, hreflang and the sitemap. Production: https://your-domain.
# If empty on Netlify, Netlify's read-only URL variable (the site's main address) is used.
NEXT_PUBLIC_SITE_URL=
